<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel Kawaii - Inicio Rápido</title>
    <!-- Google Fonts para un estilo tierno y moderno -->
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
    <!-- FontAwesome para el ícono de ver contraseña -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Quicksand', sans-serif;
        }

        body {
            background-color: #121212;
            color: #fff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow-x: hidden;
            background-image: radial-gradient(#ff69b4 1px, transparent 1px);
            background-size: 30px 30px;
        }

        .container {
            background-color: #1a1a1a;
            border: 3px solid #ff69b4;
            border-radius: 25px;
            padding: 30px;
            width: 90%;
            max-width: 400px;
            box-shadow: 0 0 20px rgba(255, 105, 180, 0.4);
            text-align: center;
            position: relative;
        }

        h2 {
            color: #ff69b4;
            margin-bottom: 20px;
            font-size: 1.8rem;
        }

        .kawaii-icon {
            font-size: 3rem;
            color: #ffb6c1;
            margin-bottom: 15px;
        }

        .input-group {
            position: relative;
            margin-bottom: 20px;
        }

        input[type="password"], input[type="text"] {
            width: 100%;
            padding: 12px 45px 12px 15px;
            border: 2px solid #ffb6c1;
            border-radius: 15px;
            background-color: #2a2a2a;
            color: #fff;
            font-size: 1rem;
            outline: none;
            transition: 0.3s;
        }

        input:focus {
            border-color: #ff69b4;
            box-shadow: 0 0 10px rgba(255, 105, 180, 0.5);
        }

        .toggle-password {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #ffb6c1;
            cursor: pointer;
            font-size: 1.2rem;
        }

        .btn {
            background-color: #ff69b4;
            color: white;
            border: none;
            border-radius: 15px;
            padding: 12px;
            width: 100%;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
            box-shadow: 0 4px 10px rgba(255, 105, 180, 0.3);
        }

        .btn:hover {
            background-color: #ff1493;
            transform: translateY(-2px);
        }

        .error-msg {
            color: #ff6b6b;
            font-size: 0.9rem;
            margin-top: 10px;
            display: none;
        }

        /* Panel de Inicio Rápido (Oculto inicialmente) */
        #quick-panel {
            display: none;
        }

        .links-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 15px;
            margin-top: 20px;
        }

        .quick-link {
            background-color: #2a2a2a;
            border: 2px solid #ffb6c1;
            padding: 12px;
            border-radius: 15px;
            color: #fff;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .quick-link:hover {
            background-color: #ff69b4;
            border-color: #fff;
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- SECCIÓN DE LOGIN -->
        <div id="login-section">
            <div class="kawaii-icon">✨ 🌸 ✨</div>
            <h2>Acceso al Panel</h2>
            
            <div class="input-group">
                <input type="password" id="passwordBox" placeholder="Ingresa la contraseña">
                <i class="fa-solid fa-eye toggle-password" id="togglePass"></i>
            </div>
            
            <button class="btn" onclick="checkPassword()">Entrar 💖</button>
            <p id="errorMsg" class="error-msg">Contraseña incorrecta, ¡intenta de nuevo! 🐾</p>
        </div>

        <!-- SECCIÓN DE INICIO RÁPIDO (PANEL) -->
        <div id="quick-panel">
            <div class="kawaii-icon">🎀 🚀 🎀</div>
            <h2>Inicio Rápido</h2>
            <p style="color: #ffb6c1; font-size: 0.9rem;">¡Bienvenida a tu panel personalizado!</p>
            
            <div class="links-grid">
                <a href="#" class="quick-link"><i class="fa-solid fa-house"></i> Enlace Principal</a>
                <a href="#" class="quick-link"><i class="fa-solid fa-palette"></i> Mis Diseños</a>
                <a href="#" class="quick-link"><i class="fa-solid fa-star"></i> Favoritos</a>
                <a href="#" class="quick-link" onclick="location.reload()" style="background-color: #4a1525;"><i class="fa-solid fa-arrow-right-from-bracket"></i> Salir</a>
            </div>
        </div>
    </div>

    <script>
        // Mostrar / Ocultar Contraseña
        const togglePass = document.getElementById('togglePass');
        const passwordBox = document.getElementById('passwordBox');

        togglePass.addEventListener('click', function () {
            // Cambiar tipo de input
            const type = passwordBox.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordBox.setAttribute('type', type);
            
            // Cambiar ícono del ojo
            this.classList.toggle('fa-eye');
            this.classList.toggle('fa-eye-slash');
        });

        // Verificar Contraseña (5062)
        function checkPassword() {
            const pass = passwordBox.value;
            const errorMsg = document.getElementById('errorMsg');
            const loginSection = document.getElementById('login-section');
            const quickPanel = document.getElementById('quick-panel');

            if (pass === "5062") {
                loginSection.style.display = 'none';
                quickPanel.style.display = 'block';
            } else {
                errorMsg.style.display = 'block';
                passwordBox.style.borderColor = '#ff6b6b';
            }
        }

        // Permitir entrar presionando la tecla Enter
        passwordBox.addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                checkPassword();
            }
        });
    </script>
</body>
</html>
